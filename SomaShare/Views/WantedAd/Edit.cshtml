@model SomaShare.Models.WantedAd

@{
    ViewData["Title"] = "Edit Wanted Ad";
}

<div class="container mt-4">
    <h2>Edit Wanted Ad</h2>

    <form asp-action="Edit" method="post" class="mt-4">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="OfferAmount" class="form-label"></label>
            <input asp-for="OfferAmount" type="number" step="0.01" class="form-control" placeholder="0.00" />
            <span asp-validation-for="OfferAmount" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Update Ad</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-danger">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
