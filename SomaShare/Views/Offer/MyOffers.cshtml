@model IEnumerable<Offer>

@{
    ViewData["Title"] = "My Offers";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1>My Offers</h1>
            <p class="text-muted">Offers you have made on textbooks</p>
            <hr />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Textbook</th>
                                <th>Your Offer</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model)
                            {
                                <tr>
                                    <td>Offer #@offer.Id</td>
                                    <td>$@offer.Amount.ToString("F2")</td>
                                    <td><span class="badge bg-info">Active</span></td>
                                    <td>@offer.CreatedAt.ToString("d")</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Offer", new { id = offer.Id })" class="btn btn-sm btn-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> You haven't made any offers yet.
        </div>
    }
</div>
