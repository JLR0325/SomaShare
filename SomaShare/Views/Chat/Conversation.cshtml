@model IEnumerable<SomaShare.Models.ChatMessage>
@{
    var otherUserId = ViewBag.OtherUserId;
    var otherUserName = ViewBag.OtherUserName;
    ViewData["Title"] = $"Chat with {otherUserName}";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <!-- Conversation Header -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">@otherUserName</h5>
                        <small>@ViewBag.OtherUserInstitution</small>
                    </div>
                    <a href="@Url.Action("Index", "Chat")" class="btn btn-sm btn-light">Back to Messages</a>
                </div>
            </div>

            <!-- Messages Area -->
            <div class="card" style="height: 500px; overflow-y: auto;">
                <div class="card-body" id="messagesContainer">
                    @if (Model.Any())
                    {
                        @foreach (var message in Model.OrderBy(m => m.SentAt))
                        {
                            var isCurrentUser = message.FromUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            <div class="mb-3 d-flex @(isCurrentUser ? "justify-content-end" : "justify-content-start")">
                                <div class="@(isCurrentUser ? "bg-primary text-white" : "bg-light") p-3 rounded" style="max-width: 70%;">
                                    <p class="mb-1">@message.Message</p>
                                    <small class="@(isCurrentUser ? "text-light" : "text-muted")">
                                        @message.SentAt.ToString("MMM dd, HH:mm")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <p>No messages yet. Start the conversation!</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Message Input -->
            <div class="card-footer">
                <form asp-action="SendMessage" asp-controller="Chat" method="post" class="d-flex gap-2">
                    <input type="hidden" name="toUserId" value="@otherUserId" />
                    <input type="text" name="message" class="form-control" placeholder="Type a message..." required />
                    <button type="submit" class="btn btn-primary">Send</button>
                </form>
            </div>
        </div>

        <!-- User Profile Card -->
        <div class="col-md-12 mt-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">User Profile</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2">
                            @if (!string.IsNullOrEmpty(ViewBag.OtherUserProfileImage))
                            {
                                <img src="@ViewBag.OtherUserProfileImage" alt="Profile" class="img-fluid rounded" />
                            }
                            else
                            {
                                <div class="bg-secondary rounded p-5 text-center text-white">
                                    <i class="fas fa-user fa-3x"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-10">
                            <h6><strong>Name:</strong> @otherUserName</h6>
                            <h6><strong>Institution:</strong> @ViewBag.OtherUserInstitution</h6>
                            <h6><strong>Course:</strong> @ViewBag.OtherUserCourse</h6>
                            <h6><strong>Rating:</strong> <span class="badge bg-warning text-dark">@ViewBag.OtherUserRating.ToString("F1") ⭐</span></h6>
                            <a href="@Url.Action("View", "Profile", new { userId = otherUserId })" class="btn btn-info btn-sm mt-2">View Full Profile</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-scroll to bottom
        var messagesContainer = document.getElementById('messagesContainer');
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Auto-refresh messages every 3 seconds
        setInterval(function () {
            location.reload();
        }, 3000);
    </script>
}
