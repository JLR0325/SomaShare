@{
    ViewData["Title"] = "Welcome to SomaShare";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">SomaShare</h1>
        <p class="lead">
            A student-focused platform to <strong>buy, sell, and exchange textbooks</strong>
            within your university community.
        </p>
        <p>
            Inspired by African digital innovation, SomaShare promotes affordability, trust,
            and accessibility for all students.
        </p>
        <a href="/Account/Register" class="btn btn-primary btn-lg me-2">Get Started</a>
        <a href="/Account/Login" class="btn btn-outline-secondary btn-lg">Login</a>
    </div>

    <hr />

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <h3>Textbook Listings</h3>
            <p>Browse and post textbooks for sale. Search by title, author, ISBN, or campus.</p>
            <a href="/Textbook" class="btn btn-success">View Listings</a>
        </div>
        <div class="col-md-4 mb-4">
            <h3> & Transactions</h3>
            <p>Make offers, negotiate prices, and complete transactions safely with peers.</p>
            <a href="/Offer" class="btn btn-success">Make an Offer</a>
        </div>
        <div class="col-md-4 mb-4">
            <h3>Community & Trust</h3>
            <p>Build your reputation with reviews and a community trust score.</p>
            <a href="/Forum" class="btn btn-success">Join the Forum</a>
        </div>
    </div>

    <hr />

    <div class="row mt-5">
        <div class="col-md-6">
            <h4>Why SomaShare?</h4>
            <ul>
                <li>Affordable access to prescribed textbooks</li>
                <li>Role-based access (Student, Seller, Admin)</li>
                <li>Secure authentication with ASP.NET Identity</li>
                <li>Community-driven Africanisation principles</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h4>Features</h4>
            <ul>
                <li>Registration & login with university email</li>
                <li>CRUD operations for textbooks, offers, and reviews</li>
                <li>Search, filtering, and dashboards</li>
                <li>Responsive design for mobile and desktop</li>
            </ul>
        </div>
    </div>
</div>
