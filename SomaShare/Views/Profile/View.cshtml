@using SomaShare.Controllers
@using System.Security.Claims
@model UserProfileViewModel
@{
    ViewData["Title"] = @Model.User.FullName + " - Profile";
}

<div class="container mt-5">
    <!-- Profile Header -->
    <div class="row mb-4">
        <div class="col-md-3 text-center">
            <img src="@Model.User.GetProfileImageUrl()" alt="@Model.User.FullName" class="img-fluid rounded-circle" style="width: 200px; height: 200px; object-fit: cover;" />
        </div>
        <div class="col-md-9">
            <h1>@Model.User.FullName</h1>

            <div class="mb-3">
                <h5>Community Trust Score</h5>
                <div>
                    <span class="h3 text-warning">★ @Model.AverageRating.ToString("F1")</span>
                    <span class="text-muted">(@Model.ReviewCount reviews)</span>
                </div>
            </div>

            <div class="mb-3">
                <p><strong>Institution:</strong> @(string.IsNullOrEmpty(Model.User.Institution) ? "Not specified" : Model.User.Institution)</p>
                <p><strong>Course:</strong> @(string.IsNullOrEmpty(Model.User.Course) ? "Not specified" : Model.User.Course)</p>
                <p><strong>Campus:</strong> @(string.IsNullOrEmpty(Model.User.Campus) ? "Not specified" : Model.User.Campus)</p>
                <p><strong>Email:</strong> @Model.User.Email</p>
                <p><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "Not provided" : Model.User.PhoneNumber)</p>
            </div>

            @if (User.Identity?.IsAuthenticated == true && User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier) != Model.User.Id)
            {
                <a asp-controller="Review" asp-action="Create" asp-route-reviewedUserId="@Model.User.Id" class="btn btn-danger">
                    Leave a Review
                </a>
            }
        </div>
    </div>

    <hr class="my-4" />

    <!-- Reviews Section -->
    <div class="row mb-4">
        <div class="col-12">
            <h3>Reviews (@Model.Reviews.Count)</h3>

            @if (Model.Reviews.Any())
            {
                @foreach (var review in Model.Reviews)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="card-subtitle mb-1">
                                        <strong>@review.Reviewer?.FullName</strong>
                                        <span class="text-warning">★ @review.Rating/5</span>
                                    </h6>
                                    <p class="text-muted mb-2">@review.ReviewDate.ToString("dd MMM yyyy")</p>
                                    <p class="card-text">@review.Comment</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No reviews yet.</p>
            }
        </div>
    </div>

    <!-- Listings Section -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <h3>Textbook Listings (@Model.TextbookListings.Count)</h3>

            @if (Model.TextbookListings.Any())
            {
                <div class="row">
                    @foreach (var textbook in Model.TextbookListings)
                    {
                        <div class="col-12 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">@textbook.Title</h5>
                                    <p class="card-text">
                                        <small><strong>By:</strong> @textbook.Author</small><br />
                                        <small><strong>Condition:</strong> @textbook.Condition</small>
                                    </p>
                                    <p class="card-text text-danger"><strong>$@textbook.Price.ToString("F2")</strong></p>
                                    @if (textbook.IsSold)
                                    {
                                        <span class="badge bg-danger">SOLD</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Textbook" asp-action="Details" asp-route-id="@textbook.Id" class="btn btn-sm btn-danger">View Details</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No textbook listings.</p>
            }
        </div>

        <div class="col-md-6 mb-4">
            <h3>Wanted Ad Listings (@Model.WantedAdListings.Count)</h3>

            @if (Model.WantedAdListings.Any())
            {
                <div class="row">
                    @foreach (var ad in Model.WantedAdListings)
                    {
                        <div class="col-12 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">@ad.Title</h5>
                                    <p class="card-text">@ad.Description</p>
                                    <p class="card-text text-danger"><strong>Offering: $@ad.OfferAmount.ToString("F2")</strong></p>
                                    <small class="text-muted">Posted @ad.PostedDate.ToString("dd MMM yyyy")</small><br />
                                    <a asp-controller="WantedAd" asp-action="Details" asp-route-id="@ad.Id" class="btn btn-sm btn-danger">View Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No wanted ad listings.</p>
            }
        </div>
    </div>

    <hr class="my-4" />
    <a href="javascript:history.back()" class="btn btn-outline-danger">Back</a>
</div>
