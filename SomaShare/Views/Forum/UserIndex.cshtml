@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <h1>Welcome back, @User.Identity.Name!</h1>
        <p class="lead">Go to your dashboard to manage listings, offers, and transactions.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Dashboard">My Dashboard</a>
    }
    else
    {
        <h1>Welcome to SomaShare</h1>
        <p class="lead">Buy, sell, and exchange textbooks with your university community.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get Started</a>
        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Login</a>
    }
</div>
