@model IEnumerable<Transaction>

@{
    ViewData["Title"] = "My Transactions";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1>My Transactions</h1>
            <p class="text-muted">Your buying and selling history</p>
            <hr />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Transaction ID</th>
                                <th>Amount</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in Model.OrderByDescending(t => t.TransactionDate))
                            {
                                var isMe = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                                var role = transaction.BuyerId == isMe ? "Buyer" : "Seller";

                                <tr>
                                    <td>#@transaction.Id.ToString().Substring(0, 8)</td>
                                    <td>$@transaction.FinalPrice.ToString("F2")</td>
                                    <td>@role</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                    <td>@transaction.TransactionDate.ToString("d")</td>
                                    <td>
                                        <a href="@Url.Action("Details", "Transaction", new { id = transaction.Id })" class="btn btn-sm btn-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> You don't have any transactions yet.
        </div>
    }
</div>
