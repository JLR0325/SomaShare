@model IEnumerable<Review>

@{
    ViewData["Title"] = "My Reviews";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1>Reviews About Me</h1>
            <p class="text-muted">Feedback from buyers and sellers</p>
            <hr />
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var review in Model.OrderByDescending(r => r.ReviewDate))
            {
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">
                                    <span class="badge bg-warning text-dark">@review.Rating ⭐</span>
                                </h5>
                                <small class="text-muted">@review.ReviewDate.ToString("g")</small>
                            </div>
                            <p class="card-text">@review.Comment</p>
                            <small class="text-muted">By: @review.ReviewerId</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> You don't have any reviews yet.
        </div>
    }
</div>
