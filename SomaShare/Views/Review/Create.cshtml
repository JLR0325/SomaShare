@{
    ViewData["Title"] = "Leave a Review";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2>Leave a Review for @ViewBag.ReviewedUserName</h2>
            <p class="text-muted">Share your experience with this user to help build our community trust system.</p>

            <form method="post" asp-action="Create" class="mt-4">
                <input type="hidden" name="reviewedUserId" value="@ViewBag.ReviewedUserId" />
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <div class="rating-input">
                        <div class="btn-group" role="group">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" class="btn-check" name="rating" id="star@i" value="@i" />
                                <label class="btn btn-outline-warning" for="star@i">
                                    @i
                                </label>
                            }
                        </div>
                    </div>
                    <small class="form-text text-muted d-block mt-2">Click to select a rating from 1 to 5 stars</small>
                </div>

                <div class="mb-3">
                    <label for="comment" class="form-label">Comment (Optional)</label>
                    <textarea name="comment" id="comment" class="form-control" rows="5" placeholder="Share details about your experience..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Submit Review</button>
                    <a href="javascript:history.back()" class="btn btn-outline-danger">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .rating-input .btn-check:checked + .btn {
        background-color: #ffc107;
        border-color: #ffc107;
        color: black;
    }

    .rating-input .btn {
        margin: 5px;
        padding: 10px 15px;
        font-weight: bold;
    }
</style>
