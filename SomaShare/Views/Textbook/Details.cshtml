@model SomaShare.Models.Textbook
@{
    ViewData["Title"] = "Textbook Details";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid mb-3" alt="@Model.Title" style="max-height: 400px;" />
            }
            else
            {
                <div class="bg-light p-5 mb-3 text-center">
                    <p class="text-muted">No image available</p>
                </div>
            }

            <h2 class="text-danger mb-3">@Model.Title</h2>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Book Information</h5>
                    <p>
                        <strong>Author:</strong> @Model.Author<br />
                        <strong>ISBN:</strong> @Model.ISBN<br />
                        <strong>Edition:</strong> @Model.Edition<br />
                        <strong>Condition:</strong> <span class="badge bg-info">@Model.Condition</span><br />
                        <strong>Campus:</strong> @Model.Campus
                    </p>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Seller Information</h5>
                    <p>
                        <strong>Seller:</strong> @Model.User?.FullName<br />
                        <strong>Listed:</strong> @Model.ListedDate.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title text-danger">$@Model.Price.ToString("F2")</h3>
                    @if (Model.IsSold)
                    {
                        <p class="text-muted"><strong>SOLD</strong></p>
                    }
                    else
                    {
                        <button class="btn btn-success w-100 mb-2">Make an Offer</button>
                    }
                    <a asp-controller="Textbook" asp-action="Index" class="btn btn-outline-secondary w-100">Back to Listings</a>
                </div>
            </div>
        </div>
    </div>
</div>
