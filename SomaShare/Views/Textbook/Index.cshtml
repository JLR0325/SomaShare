@model IEnumerable<SomaShare.Models.Textbook>
@{
    ViewData["Title"] = "Textbook Listings";
}

<h2>Available Textbooks</h2>

<form asp-controller="Textbook" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
               class="form-control" placeholder="Search by title, author, or ISBN..." />
        <button type="submit" class="btn btn-danger">Search</button>
    </div>
</form>

<form asp-controller="Textbook" asp-action="Index" method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="campus" value="@ViewBag.Campus" class="form-control" placeholder="Campus" />
        </div>
        <div class="col-md-3">
            <select name="condition" class="form-select">
                <option value="">Any condition</option>
                @if (ViewBag.Condition == "New")
                {
                    <option value="New" selected>New</option>
                }
                else
                {
                    <option value="New">New</option>
                }

                @if (ViewBag.Condition == "Good")
                {
                    <option value="Good" selected>Good</option>
                }
                else
                {
                    <option value="Good">Good</option>
                }

                @if (ViewBag.Condition == "Fair")
                {
                    <option value="Fair" selected>Fair</option>
                }
                else
                {
                    <option value="Fair">Fair</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="minPrice" value="@ViewBag.MinPrice" class="form-control" placeholder="Min R" />
        </div>
        <div class="col-md-2">
            <input type="number" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" placeholder="Max R" />
        </div>
        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="">Sort</option>
                @if (ViewBag.SortOrder == "price_asc") { <option value="price_asc" selected>Price ↑</option> } else { <option value="price_asc">Price ↑</option> }
                @if (ViewBag.SortOrder == "price_desc") { <option value="price_desc" selected>Price ↓</option> } else { <option value="price_desc">Price ↓</option> }
                @if (ViewBag.SortOrder == "date") { <option value="date" selected>Newest</option> } else { <option value="date">Newest</option> }
            </select>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">No listings found.</div>
}
else
{
    <div class="row">
        @foreach (var book in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title text-danger">@book.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@book.Author</h6>
                        <p>ISBN: @book.ISBN</p>
                        <p><strong>R @book.Price</strong> • @book.Condition • @book.Campus</p>
                        <a asp-controller="Textbook" asp-action="Details" asp-route-id="@book.Id"
                           class="btn btn-outline-secondary">View Details</a>
                    </div>
                </div>
            </div>
        }

@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                    <a class="page-link" asp-controller="Textbook" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.SearchString" asp-route-condition="@ViewBag.Condition" asp-route-campus="@ViewBag.Campus" asp-route-minPrice="@ViewBag.MinPrice" asp-route-maxPrice="@ViewBag.MaxPrice" asp-route-sortOrder="@ViewBag.SortOrder">@i</a>
                </li>
            }
        </ul>
    </nav>
}
    </div>
}
