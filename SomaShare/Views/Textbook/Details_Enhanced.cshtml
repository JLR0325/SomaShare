@model Textbook
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = Model.Title;
    var currentUserId = UserManager.GetUserId(User);
    var isOwnListing = currentUserId == Model.UserId;
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Textbooks</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Book Image and Details -->
        <div class="col-md-6">
            <div class="card mb-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div style="height: 400px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-book text-white" style="font-size: 100px;"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Book Information and Seller Card -->
        <div class="col-md-6">
            <!-- Book Details Card -->
            <div class="card mb-4">
                <div class="card-body">
                    <h2>@Model.Title</h2>
                    <p class="text-muted"><strong>Author:</strong> @Model.Author</p>
                    <p class="text-muted"><strong>ISBN:</strong> @Model.ISBN</p>
                    <p class="text-muted"><strong>Edition:</strong> @Model.Edition</p>

                    <div class="mb-3">
                        <span class="badge bg-info">Condition: @Model.Condition</span>
                        <span class="badge bg-secondary">@Model.Campus Campus</span>
                    </div>

                    <h4 class="text-success mb-3">
                        R @Model.Price.ToString("F2")
                    </h4>

                    <p class="text-muted">
                        <small>Listed on @Model.ListedDate.ToString("MMMM dd, yyyy")</small>
                    </p>

                    @if (!isOwnListing && User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Create", "Offer", new { textbookId = Model.Id })" class="btn btn-success btn-lg w-100 mb-2">
                            <i class="fas fa-handshake"></i> Make an Offer
                        </a>
                    }

                    @if (isOwnListing)
                    {
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning btn-lg w-100 mb-2">
                            <i class="fas fa-edit"></i> Edit Listing
                        </a>
                        <a href="@Url.Action("Delete", new { id = Model.Id })" class="btn btn-danger btn-lg w-100">
                            <i class="fas fa-trash"></i> Delete Listing
                        </a>
                    }

                    @if (!User.Identity.IsAuthenticated)
                    {
                        <div class="alert alert-info">
                            <a href="@Url.Action("Login", "Account")">Login</a> to make an offer or contact the seller.
                        </div>
                    }
                </div>
            </div>

            <!-- Seller Information Card -->
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">About the Seller</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.User.ProfileImageUrl))
                        {
                            <img src="@Model.User.ProfileImageUrl" alt="@Model.User.FullName" 
                                 class="rounded-circle me-3" style="width: 80px; height: 80px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary rounded-circle me-3" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-user text-white" style="font-size: 40px;"></i>
                            </div>
                        }
                        <div>
                            <h5>
                                <a href="@Url.Action("View", "Profile", new { userId = Model.UserId })" class="text-decoration-none">
                                    @Model.User.FullName
                                </a>
                            </h5>
                            <p class="mb-0">
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-star"></i> @Model.User.Rating.ToString("F1")
                                </span>
                            </p>
                        </div>
                    </div>

                    <p><strong>Institution:</strong> @Model.User.Institution</p>
                    <p><strong>Course:</strong> @Model.User.Course</p>
                    <p><strong>Campus:</strong> @Model.User.Campus</p>

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("View", "Profile", new { userId = Model.UserId })" class="btn btn-info">
                            <i class="fas fa-user-circle"></i> View Full Profile
                        </a>
                        @if (!isOwnListing && User.Identity.IsAuthenticated)
                        {
                            <a href="@Url.Action("StartConversation", "Chat", new { userId = Model.UserId })" class="btn btn-primary">
                                <i class="fas fa-envelope"></i> Send Message
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Offers Section -->
    @if (Model.Offers.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Active Offers (@Model.Offers.Count)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Offeror</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var offer in Model.Offers)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("View", "Profile", new { userId = offer.UserId })">
                                                    @offer.User.FullName
                                                </a>
                                            </td>
                                            <td><strong>R @offer.Amount.ToString("F2")</strong></td>
                                            <td><span class="badge bg-info">@offer.Status</span></td>
                                            <td>@offer.OfferDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @if (isOwnListing)
                                                {
                                                    <a href="@Url.Action("View", "Offer", new { id = offer.Id })" class="btn btn-sm btn-primary">
                                                        Review
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .badge {
        font-size: 12px;
        padding: 6px 10px;
    }
</style>
