@using SomaShare.Models
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Browse Users";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h1>Browse Users</h1>
            <p class="text-muted">Find and chat with other users</p>
            <hr />
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Browse" asp-controller="Profile" method="get" class="row g-3">
                        <div class="col-md-6">
                            <label for="search" class="form-label">Search (Name, Email, Institution, Course)</label>
                            <input type="text" class="form-control" id="search" name="search" 
                                   placeholder="Search users..." value="@ViewBag.CurrentSearch" />
                        </div>
                        <div class="col-md-6">
                            <label for="campus" class="form-label">Filter by Campus</label>
                            <select class="form-select" id="campus" name="campus">
                                <option value="">All Campuses</option>
                                @foreach (var c in ViewBag.Campuses ?? new List<string>())
                                {
                                    <option value="@c" selected="@(c == ViewBag.CurrentCampus ? "selected" : "")">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Search</button>
                            <a href="@Url.Action("Browse", "Profile")" class="btn btn-secondary">Clear Filters</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var user in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <!-- User Image -->
                        <div class="card-img-top" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); height: 150px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                            {
                                <img src="@user.ProfileImageUrl" alt="@user.FullName" class="img-fluid rounded-circle" style="max-width: 120px; max-height: 120px;" />
                            }
                            else
                            {
                                <div class="text-white text-center">
                                    <i class="fas fa-user fa-5x"></i>
                                </div>
                            }
                        </div>

                        <!-- User Info -->
                        <div class="card-body">
                            <h5 class="card-title">@user.FullName</h5>
                            <p class="card-text">
                                <small class="text-muted">
                                    @if (!string.IsNullOrEmpty(user.Institution))
                                    {
                                        <div><i class="fas fa-graduation-cap"></i> @user.Institution</div>
                                    }
                                    @if (!string.IsNullOrEmpty(user.Course))
                                    {
                                        <div><i class="fas fa-book"></i> @user.Course</div>
                                    }
                                    @if (!string.IsNullOrEmpty(user.Campus))
                                    {
                                        <div><i class="fas fa-map-marker-alt"></i> @user.Campus</div>
                                    }
                                </small>
                            </p>
                            <div class="mb-3">
                                <span class="badge bg-warning text-dark">@user.Rating.ToString("F1") ⭐</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="card-footer bg-white">
                            <a href="@Url.Action("View", "Profile", new { userId = user.Id })" class="btn btn-sm btn-info w-100 mb-2">
                                <i class="fas fa-eye"></i> View Profile
                            </a>
                            <a href="@Url.Action("StartConversation", "Chat", new { userId = user.Id })" class="btn btn-sm btn-primary w-100">
                                <i class="fas fa-comments"></i> Start Chat
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> No users found. Try adjusting your search criteria.
        </div>
    }
</div>
