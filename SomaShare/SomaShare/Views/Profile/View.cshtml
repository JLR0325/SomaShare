@using SomaShare.Models
@model UserProfileViewModel

@{
    ViewData["Title"] = Model?.FullName ?? "User Profile";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mt-5">
    <div class="row">
        <!-- User Profile Card -->
        <div class="col-md-4">
            <div class="card">
                <!-- Profile Image -->
                <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); height: 200px; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrEmpty(Model?.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="@Model.FullName" class="img-fluid rounded-circle" style="max-width: 150px; max-height: 150px; object-fit: cover; border: 5px solid white;" />
                    }
                    else
                    {
                        <div class="text-white text-center">
                            <i class="fas fa-user fa-5x"></i>
                        </div>
                    }
                </div>

                <!-- User Info -->
                <div class="card-body text-center">
                    <h3 class="card-title">@Model?.FullName</h3>
                    <p class="text-muted">@Model?.Email</p>

                    <div class="mb-3">
                        <span class="badge bg-warning text-dark">@Model?.Rating.ToString("F1") ⭐</span>
                    </div>

                    <div class="list-unstyled">
                        @if (!string.IsNullOrEmpty(Model?.Institution))
                        {
                            <p><i class="fas fa-graduation-cap"></i> @Model.Institution</p>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Course))
                        {
                            <p><i class="fas fa-book"></i> @Model.Course</p>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Campus))
                        {
                            <p><i class="fas fa-map-marker-alt"></i> @Model.Campus</p>
                        }
                    </div>

                    <!-- Action Buttons -->
                    @if (!string.IsNullOrEmpty(currentUserId) && currentUserId != Model?.Id)
                    {
                        <div class="d-grid gap-2">
                            <a href="@Url.Action("StartConversation", "Chat", new { userId = Model.Id })" class="btn btn-primary">
                                <i class="fas fa-comments"></i> Send Message
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- User Statistics and Details -->
        <div class="col-md-8">
            <!-- Statistics -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Active Listings</h5>
                            <h2 class="text-primary">@Model?.TextbooksCount</h2>
                            <small class="text-muted">Textbooks for sale</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Reviews</h5>
                            <h2 class="text-success">@Model?.ReviewsCount</h2>
                            <small class="text-muted">User reviews</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Details Card -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Profile Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Full Name</h6>
                            <p>@Model?.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Email</h6>
                            <p>@Model?.Email</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted">Institution</h6>
                            <p>@(Model?.Institution ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Course</h6>
                            <p>@(Model?.Course ?? "N/A")</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Campus</h6>
                            <p>@(Model?.Campus ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Rating</h6>
                            <p>@Model?.Rating.ToString("F1") ⭐</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Back Button -->
    <div class="row mt-4">
        <div class="col-12">
            <a href="@Url.Action("Browse", "Profile")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Browse
            </a>
        </div>
    </div>
</div>
